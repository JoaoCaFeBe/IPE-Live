SOCKET_SERVER=10.0.0.253:3000
SOCKET_NAMESPACE=IPE.Transmissão
CULTOS_URL=http://[ENDERECO_DO_LITURGIA]:3000/Cultos

# OBS WebSocket — Monitor de Áudio (/Audio)
# Endereço da máquina onde o OBS Studio está rodando
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
# Deixe em branco se o OBS não tiver senha configurada
OBS_WS_PASS=

# Socket.IO Auth (SEC-001) — gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vazio em dev: servidor aceita conexao sem checagem (modo legacy).
# Em prod (servidor da igreja), preencha e distribua para os 3 clientes externos
# (mobile, OBS plugin, servico em 10.0.0.253).
SOCKET_TOKEN=

# Grace period (data ISO local): durante este periodo, conexoes sem token validam mas sao aceitas com warn.
# Apos D+14, mude para uma data passada e atualize SOCKET_SCHEMA_MODE para enforce.
SOCKET_AUTH_GRACE_UNTIL=2026-05-31T23:59:59-03:00

# Modo do schema validator: "warn" (default) loga payloads invalidos mas deixa passar.
# Apos grace, mude para "enforce" para descartar payloads invalidos.
SOCKET_SCHEMA_MODE=warn

# Arquivo sentinela de bypass: se existir, qualquer conexao Socket.IO e aceita (emergencia em culto).
# Operador: `touch /tmp/ipe-bypass-auth` libera; `rm /tmp/ipe-bypass-auth` restaura.
SOCKET_AUTH_BYPASS_FILE=/tmp/ipe-bypass-auth