<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= titulo %></title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="stylesheet" href="/Bibliotecas/bootstrap.min.css">
    <link rel="stylesheet" href="/css/Painel.css">
</head>

<!-- Erro em tela de operação: mesmo escuro do Live, frase de operador e o caminho de volta.
     A mensagem técnica vai só para o log do servidor. -->
<body class="bg-dark">
    <main class="estado-vazio estado-erro">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ffc107" stroke-width="1.6" aria-hidden="true">
            <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5z"></path>
            <path d="M4 21.5A2.5 2.5 0 0 1 6.5 19H20v3H6.5"></path>
            <path d="M12 7v5M12 15h.01"></path>
        </svg>
        <h1 class="estado-titulo"><%= titulo %></h1>
        <p class="estado-texto"><%= texto %></p>
        <a class="btn btn-light estado-acao" href="/Painel">Voltar ao Painel</a>
    </main>
</body>

</html>
