<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta http-equiv="cache-control" content="no-cache">
    <meta http-equiv="expires" content="0">
    <meta http-equiv="pragma" content="no-cache">
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport"
        content="user-scalable=no, initial-scale=1, maximum-scale=1, minimum-scale=1, width=device-width, height=device-height, shrink-to-fit=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <!-- ---------------------------------------------------------------------------------- -->
    <%- include('includes/bibliotecas.ejs') %>
        <!-- ---------------------------------------------------------------------------------- -->
        <title>Painel</title>
        <link rel="stylesheet" href="css/Painel.css">
        <script src="js/Painel.js" painelOBS="<%= painelOBS ? 'painelOBS' : '' %>"></script>
        <script src="js/BibliaSeletor.js"></script>
        <!-- ---------------------------------------------------------------------------------- -->
</head>

<body class="px-0 bg-dark container-fluid scrollJC" onload="inicio();">
    <script>
        // Livros (com nº de capítulos) e versões para o seletor bíblico (js/BibliaSeletor.js)
        window.BIBLIA = <%- JSON.stringify({ livros, versoes: arquivos, versaoAtual: currentBiblia }).replace(/</g, '\\u003c') %>;
    </script>

    <!-- Topo: uma linha de 44 px. Data legível (tocar abre o seletor nativo) e, ao lado, o que este Painel
         apresenta (culto congregacional ou evento); com mais de uma opção no dia, o nome abre a escolha. -->
    <div class="topo-painel sticky-top">
        <div class="topo-linha">
            <label class="data-culto" title="Data do culto">
                <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                <span id="dataTxt"></span>
                <i class="fa-solid fa-chevron-down small" aria-hidden="true"></i>
                <input type="date" id="dataCulto" aria-label="Escolher a data do culto" onchange="trocarData(this.value)">
            </label>
            <!-- O que este Painel apresenta, na mesma linha da data. Com mais de uma opção no dia
                 (culto e evento, ou dois eventos), tocar no nome abre a escolha. -->
            <div class="dropdown position-relative seletor-culto" id="seletorEventoPainel">
                <button type="button" class="descricao-culto" id="descricaoCulto" disabled
                    aria-haspopup="true" aria-expanded="false" aria-label="Culto ou evento desta data">
                    <span class="ico"><i class="fa-solid fa-church"></i></span><span class="txt">Culto congregacional</span>
                    <span class="seta d-none" aria-hidden="true"><i class="fa-solid fa-chevron-down small"></i></span>
                </button>
                <ul class="dropdown-menu"></ul>
            </div>
        </div>
    </div>

    <!-- Lista de itens (em tela larga é a coluna da esquerda; o item aberto aparece na coluna da direita, só por CSS) -->
    <div id="itens"></div>
    <div id="detalheVazio" class="detalhe-vazio" role="status">
        <i class="fa-regular fa-hand-pointer fa-2x" aria-hidden="true"></i>
        <span>Escolha um item na lista</span>
    </div>

    <!-- Barra de operação fixa (polegar): estado; Anterior | Próxima só quando há para onde ir; Limpar, Bíblia e Mensagem -->
    <div class="barra-operacao biblia" id="barraOperacao">
        <div id="painelMensagem" class="painel-mensagem d-none">
            <input type="text" class="form-control" id="mensagem" name="mensagem" autocomplete="off"
                aria-label="Mensagem para o púlpito" placeholder="Mensagem para o púlpito (Enter envia)">
        </div>
        <div id="estadoTela" class="estado-tela nada" role="status" aria-live="polite">
            <span class="quad" aria-hidden="true"></span><span class="estado-txt">Nada na tela</span>
        </div>
        <div class="barra-corpo">
            <div class="barra-linha barra-passos d-none" id="barraPassos">
                <button type="button" class="btn btn-barra" id="btnAnterior" aria-label="Estrofe anterior" disabled>
                    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>Anterior
                </button>
                <button type="button" class="btn btn-barra btn-proxima" id="btnProxima" aria-label="Próxima estrofe" disabled>
                    Próxima<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </button>
            </div>
            <div class="barra-linha">
                <button type="button" class="btn btn-barra btn-barra2" id="btnLimparTexto" onclick="limparTexto()"
                    aria-label="Limpar as telas sem fechar as janelas bíblicas">
                    <i class="fa-solid fa-eraser" aria-hidden="true"></i>Limpar
                </button>
                <button type="button" class="btn btn-barra btn-barra2" id="btnBiblia" onclick="abrirSeletorBiblico()"
                    aria-label="Abrir a Bíblia: escolher versão, livro e capítulo">
                    <i class="fa-solid fa-book-bible" aria-hidden="true"></i>Bíblia
                </button>
                <button type="button" class="btn btn-barra btn-barra2" id="btnMensagem" aria-pressed="false"
                    aria-label="Mensagem para o púlpito">
                    <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>Mensagem
                </button>
            </div>
        </div>
    </div>

</body>

</html>
