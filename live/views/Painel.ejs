<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta http-equiv="cache-control" content="no-cache">
    <meta http-equiv="expires" content="0">
    <meta http-equiv="pragma" content="no-cache">
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport"
        content="user-scalable=no, initial-scale=1, maximum-scale=1, minimum-scale=1, width=device-width, height=device-height, shrink-to-fit=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <!-- ---------------------------------------------------------------------------------- -->
    <%- include('includes/bibliotecas.ejs') %>
        <!-- ---------------------------------------------------------------------------------- -->
        <title>Painel</title>
        <link rel="stylesheet" href="css/Painel.css">
        <script src="js/Painel.js" painelOBS="<%= painelOBS ? 'painelOBS' : '' %>"></script>
        <script src="js/BibliaSeletor.js"></script>
        <!-- ---------------------------------------------------------------------------------- -->
</head>

<body class="px-1 bg-dark container-fluid scrollJC" onload="inicio();">
    <div class="sticky-top bg-dark pt-1 pb-1" style="z-index: 1050; box-shadow: 0 4px 6px -6px #222;">
        <div class="input-group mb-1 biblia">
            <button type="button" class="btn btn-warning w-100 text-start d-flex align-items-center gap-2"
                id="btnBiblia" onclick="abrirSeletorBiblico()" title="Escolher versão, livro e capítulo">
                <i class="fa-solid fa-book-bible"></i>
                <span id="bibliaAtual" class="flex-grow-1 text-truncate">Bíblia — escolher livro e capítulo</span>
                <i class="fa-solid fa-chevron-down small"></i>
            </button>
        </div>
        <script>
            // Livros (com nº de capítulos) e versões para o seletor bíblico (js/BibliaSeletor.js)
            window.BIBLIA = <%- JSON.stringify({ livros, versoes: arquivos, versaoAtual: currentBiblia }).replace(/</g, '\\u003c') %>;
        </script>
        <div class="input-group input-group-sm">
            <span class="input-group-text" title="Data do culto"><i class="fa-solid fa-calendar-day"></i></span>
            <input type="date" class="form-control" id="dataCulto" style="max-width: 16ch;"
                onchange="trocarData(this.value)">
            <input type="text" class="form-control" id='mensagem' name='mensagem' placeholder="Mensagem para o pulpito">
        </div>
    </div>

</body>

</html>