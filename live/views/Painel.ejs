<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta http-equiv="cache-control" content="no-cache">
    <meta http-equiv="expires" content="0">
    <meta http-equiv="pragma" content="no-cache">
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport"
        content="user-scalable=no, initial-scale=1, maximum-scale=1, minimum-scale=1, width=device-width, height=device-height, shrink-to-fit=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <!-- ---------------------------------------------------------------------------------- -->
    <%- include('includes/bibliotecas.ejs') %>
        <!-- ---------------------------------------------------------------------------------- -->
        <title>Painel</title>
        <link rel="stylesheet" href="css/Painel.css">
        <script src="js/Painel.js" painelOBS="<%= painelOBS ? 'painelOBS' : '' %>"></script>
        <script src="js/BibliaSeletor.js"></script>
        <!-- ---------------------------------------------------------------------------------- -->
</head>

<body class="px-1 bg-dark container-fluid scrollJC" onload="inicio();">
    <div class="sticky-top bg-dark pt-1 pb-1" style="z-index: 1050; box-shadow: 0 4px 6px -6px #222;">
        <div class="btn-group d-flex mb-1 biblia painel-projecao" role="group" aria-label="Controles de projeção">
            <button type="button" class="btn btn-warning text-start d-flex align-items-center gap-2"
                id="btnBiblia" onclick="abrirSeletorBiblico()" title="Escolher versão, livro e capítulo">
                <i class="fa-solid fa-book-bible flex-shrink-0"></i>
                <span id="bibliaAtual" class="flex-grow-1 text-truncate">Bíblia — escolher livro e capítulo</span>
                <i class="fa-solid fa-chevron-down small flex-shrink-0"></i>
            </button>
            <button type="button" class="btn btn-secondary" id="btnLimparTexto" onclick="limparTexto()"
                title="Limpar o texto das telas sem fechar as janelas bíblicas">
                <i class="fa-solid fa-eraser" aria-hidden="true"></i> Limpar
            </button>
        </div>
        <script>
            // Livros (com nº de capítulos) e versões para o seletor bíblico (js/BibliaSeletor.js)
            window.BIBLIA = <%- JSON.stringify({ livros, versoes: arquivos, versaoAtual: currentBiblia }).replace(/</g, '\\u003c') %>;
        </script>
        <!-- Data e o que este Painel apresenta: o culto congregacional ou o evento (seletor ao lado
             da data quando o dia tem evento; trocar recarrega no canal do escolhido) -->
        <div class="input-group input-group-sm linha-culto">
            <span class="input-group-text" title="Data do culto"><i class="fa-solid fa-calendar-day"></i></span>
            <input type="date" class="form-control" id="dataCulto" style="max-width: 16ch;"
                onchange="trocarData(this.value)">
            <div class="dropdown position-relative d-none" id="seletorEventoPainel">
                <button type="button" class="btn seletor-evento h-100" aria-haspopup="true" aria-expanded="false"
                    title="Escolher o que este Painel apresenta nesta data" aria-label="Culto ou evento desta data">
                    <i class="fa-solid fa-people-roof"></i>&nbsp;<span class="qtd"></span>
                </button>
                <ul class="dropdown-menu"></ul>
            </div>
            <span class="input-group-text descricao-culto flex-grow-1" id="descricaoCulto">
                <span class="ico"><i class="fa-solid fa-church"></i></span>&nbsp;<span class="txt">Culto congregacional</span>
            </span>
        </div>
    </div>

    <!-- Mensagem para o púlpito: rodapé fixo no fim da janela (pedido do João, 21/11/2026) -->
    <div class="rodape-mensagem fixed-bottom bg-dark px-1 py-1">
        <div class="input-group input-group-sm">
            <span class="input-group-text" title="Mensagem para o púlpito (Enter envia)"><i class="fa-solid fa-comment-dots"></i></span>
            <input type="text" class="form-control" id='mensagem' name='mensagem' placeholder="Mensagem para o púlpito (Enter envia)">
        </div>
    </div>

</body>

</html>
