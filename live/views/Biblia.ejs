<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- ---------------------------------------------------------------------------------- -->
    <%- include('includes/bibliotecas.ejs') %>
        <!-- ---------------------------------------------------------------------------------- -->
        <title>
            <%= nomeLivro %>
                <%= capitulo %>
        </title>
        <link rel="stylesheet" href="css/Painel.css">
        <script src="js/Biblia.js"></script>
        <style>
            html,
            body {
                height: 100vh !important;
                margin: 0;
            }

            body {
                display: flex;
                flex-direction: column;
                overflow: hidden !important;
            }

            #bibliaVersos {
                flex: 1;
                overflow-y: auto;
                padding-bottom: 0.5rem;
            }

            #bibliaRodape {
                flex-shrink: 0;
                padding: 0.6rem 1rem;
                background-color: #2d2d2d;
                border-top: 1px solid #555;
            }
        </style>
        <!-- ---------------------------------------------------------------------------------- -->
</head>

<body class="p-1 bg-dark container-fluid" onload="inicio();" data-livro="<%= livro %>" data-capitulo="<%= capitulo %>"
    data-max-capitulo="<%= maxCapitulo %>" data-nome-livro="<%= nomeLivro %>" data-biblia="<%= biblia %>"
    data-livro-anterior-id="<%= livroAnterior ? livroAnterior.id : '' %>"
    data-livro-anterior-nome="<%= livroAnterior ? livroAnterior.name : '' %>"
    data-max-capitulo-anterior="<%= maxCapituloAnterior %>"
    data-livro-proximo-id="<%= livroProximo ? livroProximo.id : '' %>"
    data-livro-proximo-nome="<%= livroProximo ? livroProximo.name : '' %>">

    <div id="bibliaVersos" class="btn-group-vertical" role="group" aria-label="Vertical button group"
        style='width:100%; display:block!important;'>
        <% versiculos.forEach((v, i)=> { %>
            <input type='radio' class='btn-check' name='btnPassagem' id='btnPassagem<%= i %>'
                titulo='<%= v.name %> <%= capitulo %>' autocomplete='off'>
            <label class='btn btn-secondary text-start'
                style='text-overflow:unset!important;white-space:normal!important;' for='btnPassagem<%= i %>'>
                <%= v.verse %>. <%= v.text %>
            </label>
            <% }); %>
    </div>

    <div id="bibliaRodape">
        <div class="position-relative d-flex align-items-center justify-content-between w-100">
            <% const temAnterior=capitulo> 1 || livroAnterior;
                const temProximo = capitulo < maxCapitulo || livroProximo; %>

            <div style="z-index: 1;">
                <% if (temAnterior) { %>
                    <% if (capitulo> 1) { %>
                        <button class='btn btn-sm btn-warning'
                            onclick='navegar(<%= livro %>, <%= capitulo - 1 %>, <%- JSON.stringify(nomeLivro) %>)'>
                            ◄ Anterior
                        </button>
                    <% } else { %>
                        <button class='btn btn-sm btn-warning'
                            onclick='navegar(<%= livroAnterior.id %>, <%= maxCapituloAnterior %>, <%- JSON.stringify(livroAnterior.name) %>)'>
                            ◄ Anterior
                        </button>
                    <% } %>
                <% } %>
            </div>

            <div class="position-absolute w-100 text-center pe-none" style="left: 0; line-height: 1.2;">
                <small class="text-secondary d-block">
                    <%= nomeLivro %><br>
                    <%= capitulo %>/<%= maxCapitulo %>
                </small>
            </div>

            <div style="z-index: 1;">
                <% if (temProximo) { %>
                    <% if (capitulo < maxCapitulo) { %>
                        <button class='btn btn-sm btn-warning'
                            onclick='navegar(<%= livro %>, <%= capitulo + 1 %>, <%- JSON.stringify(nomeLivro) %>)'>
                            Próximo ►
                        </button>
                    <% } else { %>
                        <button class='btn btn-sm btn-warning'
                            onclick='navegar(<%= livroProximo.id %>, 1, <%- JSON.stringify(livroProximo.name) %>)'>
                            Próximo ►
                        </button>
                    <% } %>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        const navegar = (livro_id, cap, nomeLvr, sel) => {
            const versao = document.body.dataset.biblia;
            let url = `Biblia?nomeLivro=${encodeURIComponent(nomeLvr)}&livro=${livro_id}&capitulo=${cap}&biblia=${versao}`;
            if (sel) url += `&sel=${sel}`;
            window.location.href = url;
        };
    </script>
</body>

</html>