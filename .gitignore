.tmp_*

# macOS
.DS_Store
**/.DS_Store

# IDEs e editores
.vscode/
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# Logs
*.log

# favicon servido pelo Express em Live/public/
favicon.ico
